{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gif-communication.local/schemas/agent_handoff.v1.json",
  "title": "GIF agent handoff packet",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "verification_level": {"enum": ["response-bound", "capture-audited"]},
    "capture_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "request_id": {"type": "integer", "minimum": 1},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "package_content_sha256": {"$ref": "#/$defs/hash"},
    "result_sha256": {"$ref": "#/$defs/hash"},
    "followup_handle_state": {"enum": ["current", "closed", "detached"]},
    "image_block_count": {"type": "integer", "minimum": 1, "maximum": 12},
    "timeline_occurrence_count": {"type": "integer", "minimum": 1, "maximum": 12},
    "unique_image_count": {"type": "integer", "minimum": 1, "maximum": 12},
    "untrusted_metadata": {"$ref": "#/$defs/metadata"},
    "frames": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"oneOf": [{"$ref": "#/$defs/auditedFrame"}, {"$ref": "#/$defs/responseFrame"}]}},
    "content": {"type": "array", "minItems": 4, "maxItems": 26, "items": {"oneOf": [{"$ref": "#/$defs/textBlock"}, {"$ref": "#/$defs/imageBlock"}]}},
    "integrity": {"oneOf": [{"$ref": "#/$defs/auditedIntegrity"}, {"$ref": "#/$defs/responseIntegrity"}]}
  },
  "required": ["schema_version", "verification_level", "capture_id", "request_id", "source_sha256", "package_content_sha256", "result_sha256", "followup_handle_state", "image_block_count", "timeline_occurrence_count", "unique_image_count", "untrusted_metadata", "frames", "content", "integrity"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"verification_level": {"const": "response-bound"}}, "required": ["verification_level"]},
      "then": {
        "properties": {"followup_handle_state": {"enum": ["current", "detached"]}, "integrity": {"$ref": "#/$defs/responseIntegrity"}, "frames": {"items": {"$ref": "#/$defs/responseFrame"}}}
      },
      "else": {
        "properties": {"followup_handle_state": {"enum": ["current", "closed"]}, "integrity": {"$ref": "#/$defs/auditedIntegrity"}, "frames": {"items": {"$ref": "#/$defs/auditedFrame"}}}
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timing": {
      "type": "object",
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 299},
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 29999},
        "raw_duration_ms": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 655350}, {"type": "null"}]},
        "effective_duration_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "disposal": {"type": "integer", "minimum": 0, "maximum": 3}
      },
      "required": ["index", "start_ms", "raw_duration_ms", "effective_duration_ms", "disposal"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "media_type": {"const": "image/gif"},
        "canvas_width": {"type": "integer", "minimum": 1, "maximum": 2048},
        "canvas_height": {"type": "integer", "minimum": 1, "maximum": 2048},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "timeline_duration_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "timeline": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/timing"}},
        "timing_policy": {"type": "string", "maxLength": 256},
        "sample_policy": {"type": "string", "maxLength": 256},
        "sampled": {"type": "boolean"},
        "decoded_all_frames": {"type": "boolean"},
        "limits_hit": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}},
        "warnings": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}},
        "coverage": {"$ref": "#/$defs/coverage"}
      },
      "required": ["media_type", "canvas_width", "canvas_height", "frame_count", "timeline_duration_ms", "timeline", "timing_policy", "sample_policy", "sampled", "decoded_all_frames", "limits_hit", "warnings", "coverage"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 29999},
        "end_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "eligible_frames": {"type": "integer", "minimum": 1, "maximum": 300},
        "returned_frames": {"type": "integer", "minimum": 1, "maximum": 12},
        "omitted_frame_indices": {"type": "array", "maxItems": 300, "items": {"type": "integer", "minimum": 0, "maximum": 299}}
      },
      "required": ["start_ms", "end_ms", "eligible_frames", "returned_frames", "omitted_frame_indices"],
      "additionalProperties": false
    },
    "auditedFrame": {
      "type": "object",
      "properties": {
        "capture_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "request_id": {"type": "integer", "minimum": 1},
        "result_file": {"type": "string", "pattern": "^call-[0-9]{2}\\.json$"},
        "content_index": {"type": "integer", "minimum": 1, "maximum": 12},
        "packet_content_index": {"type": "integer", "minimum": 3, "maximum": 25},
        "image_sha256": {"$ref": "#/$defs/hash"},
        "index": {"type": "integer", "minimum": 0, "maximum": 299},
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 29999},
        "raw_duration_ms": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 655350}, {"type": "null"}]},
        "effective_duration_ms": {"type": "integer", "minimum": 1, "maximum": 30000}
      },
      "required": ["capture_id", "request_id", "result_file", "content_index", "packet_content_index", "image_sha256", "index", "start_ms", "raw_duration_ms", "effective_duration_ms"],
      "additionalProperties": false
    },
    "responseFrame": {
      "type": "object",
      "properties": {
        "capture_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "request_id": {"type": "integer", "minimum": 1},
        "content_index": {"type": "integer", "minimum": 1, "maximum": 12},
        "packet_content_index": {"type": "integer", "minimum": 3, "maximum": 25},
        "image_sha256": {"$ref": "#/$defs/hash"},
        "index": {"type": "integer", "minimum": 0, "maximum": 299},
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 29999},
        "raw_duration_ms": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 655350}, {"type": "null"}]},
        "effective_duration_ms": {"type": "integer", "minimum": 1, "maximum": 30000}
      },
      "required": ["capture_id", "request_id", "content_index", "packet_content_index", "image_sha256", "index", "start_ms", "raw_duration_ms", "effective_duration_ms"],
      "additionalProperties": false
    },
    "textBlock": {"type": "object", "properties": {"type": {"const": "text"}, "text": {"type": "string", "maxLength": 262144}}, "required": ["type", "text"], "additionalProperties": false},
    "imageBlock": {"type": "object", "properties": {"type": {"const": "image"}, "mimeType": {"const": "image/png"}, "data": {"type": "string", "maxLength": 11184812, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}}, "required": ["type", "mimeType", "data"], "additionalProperties": false},
    "responseIntegrity": {"type": "object", "properties": {"packet_sha256": {"$ref": "#/$defs/hash"}}, "required": ["packet_sha256"], "additionalProperties": false},
    "auditedIntegrity": {
      "type": "object",
      "properties": {
        "packet_sha256": {"$ref": "#/$defs/hash"},
        "capture_record_sha256": {"$ref": "#/$defs/hash"},
        "wire_sha256": {"$ref": "#/$defs/hash"},
        "result_file_sha256": {"$ref": "#/$defs/hash"},
        "result_file": {"type": "string", "pattern": "^call-[0-9]{2}\\.json$"}
      },
      "required": ["packet_sha256", "capture_record_sha256", "wire_sha256", "result_file_sha256", "result_file"],
      "additionalProperties": false
    }
  }
}
