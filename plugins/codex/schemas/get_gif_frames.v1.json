{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gif-communication:get_gif_frames:v1",
  "type": "object",
  "properties": {
    "inspection_id": {
      "type": "string",
      "pattern": "^gif1_[A-Za-z0-9_-]{43}$"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 29999
    },
    "end_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "frame_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  },
  "required": [
    "inspection_id",
    "start_ms",
    "end_ms"
  ],
  "additionalProperties": false
}
