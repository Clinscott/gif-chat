{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gif-communication:inspect_gif:v1",
  "type": "object",
  "properties": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local_file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "host_asset"
            },
            "asset_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "kind",
            "asset_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "frame_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  },
  "required": [
    "source"
  ],
  "additionalProperties": false
}
