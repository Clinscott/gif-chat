{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gif-communication:find_reply_gif_result:v1",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "matches",
            "no_match"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "library_asset"
                  },
                  "asset_id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  }
                },
                "required": [
                  "kind",
                  "asset_id"
                ],
                "additionalProperties": false
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "tags": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "string",
                      "maxLength": 32,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    }
                  },
                  "spoke": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "tone": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "avoid_when": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "maxLength": 240
                    }
                  },
                  "file": {
                    "type": "string",
                    "pattern": "^assets/[a-z][a-z0-9-]*\\.gif$"
                  },
                  "poster": {
                    "type": "string",
                    "pattern": "^posters/[a-z][a-z0-9-]*\\.png$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "poster_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1048576
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 640
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 480
                  },
                  "frame_count": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 24
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 20,
                    "maximum": 3000
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "creator": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "source": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "rights": {
                        "const": "MIT"
                      }
                    },
                    "required": [
                      "kind",
                      "creator",
                      "source",
                      "rights"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "tags",
                  "spoke",
                  "tone",
                  "avoid_when",
                  "file",
                  "poster",
                  "sha256",
                  "poster_sha256",
                  "bytes",
                  "width",
                  "height",
                  "frame_count",
                  "duration_ms",
                  "provenance"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "source",
              "metadata"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        },
        "message": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "status",
        "candidates",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z_]{1,48}$"
            },
            "message": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
